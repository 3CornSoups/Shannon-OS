# Shannon environment configuration (secrets recommended here)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 辅助模型（可选，用于委托审核/摘要等次要任务）
DEEPSEEK_AUX_MODEL=

# 通义千问（可选，用于 AIOS embedding 检索）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBED_MODEL=

# Default SSH port used by host form when port is empty
SHANNON_DEFAULT_SSH_PORT=22

# 监控采集间隔（秒），默认 60，最低 10
SHANNON_MONITOR_INTERVAL=60

# 注意：钉钉/邮件通知配置在 Web UI「设置」页中维护（存入数据库），不走环境变量
