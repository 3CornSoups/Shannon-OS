        <mxCell id="df-e8" value="③ 上下文管理" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="450" as="sourcePoint" />
            <mxPoint x="255" y="510" as="targetPoint" />
