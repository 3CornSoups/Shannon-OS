            <mxPoint x="920" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Agent → LLM -->
        <mxCell id="df-e6" value="① 发送Prompt" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#9673a6;" edge="1" parent="1">
