        <!-- LLM → Agent -->
        <mxCell id="df-e7" value="② 返回JSON/ToolCall" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#9673a6;" edge="1" parent="1">
