          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="450" as="sourcePoint" />
            <mxPoint x="490" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- SSH Pool → Target -->
        <mxCell id="df-e11" value="⑥ 远程执行" style="endArrow=block;endFill=1;strokeColor=#e07b39;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#e07b39;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="555" as="sourcePoint" />
            <mxPoint x="490" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Target → Executor (返回) -->
        <mxCell id="df-e12" value="⑦ 命令输出" style="endArrow=open;endFill=0;strokeColor=#82b366;strokeWidth=2;dashed=1;fontSize=10;fontStyle=1;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="620" as="sourcePoint" />
            <mxPoint x="440" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Executor → Agent (返回结果) -->
        <mxCell id="df-e13" value="⑧ 执行结果" style="endArrow=open;endFill=0;strokeColor=#82b366;strokeWidth=2;dashed=1;fontSize=10;fontStyle=1;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="410" as="sourcePoint" />
            <mxPoint x="350" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Agent → EventStore -->
        <mxCell id="df-e14" value="⑨ 推送事件" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="415" as="sourcePoint" />
            <mxPoint x="700" y="415" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- EventStore → 前端 (SSE) -->
        <mxCell id="df-e15" value="⑩ SSE实时推送" style="endArrow=open;endFill=0;strokeColor=#82b366;strokeWidth=2;dashed=1;fontSize=10;fontStyle=1;fontColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="400" as="sourcePoint" />
            <mxPoint x="700" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- Agent → Database -->
        <mxCell id="df-e16" value="⑪ 记录日志/审计" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="440" as="sourcePoint" />
            <mxPoint x="870" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- ===== ReAct循环标注 ===== -->
        <mxCell id="df-react-box" value="" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#e07b39;strokeWidth=2;dashed=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="15" y="380" width="810" height="200" as="geometry" />
        </mxCell>
        <mxCell id="df-react-label" value="ReAct 循环 (最多20轮)&#xa;思考 → 行动 → 观察 → 再思考..." style="text;html=1;fontSize=12;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#e07b39;" vertex="1" parent="1">
          <mxGeometry x="250" y="560" width="300" height="35" as="geometry" />
        </mxCell>
        <!-- ===== 完整流程说明 ===== -->
        <mxCell id="df-flow-desc" value="&lt;b&gt;核心数据流说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 用户发送消息 → 前端HTTP请求 → API路由层&lt;br&gt;② API创建ShannonAgent，加载会话历史&lt;br&gt;③ Agent构建System Prompt，调用LLM API&lt;br&gt;④ LLM返回结构化JSON或ToolCall&lt;br&gt;⑤ Agent验证风险等级，高危命令等待用户确认&lt;br&gt;⑥ 确认后进入ReAct循环：执行命令→观察结果→决策下一步&lt;br&gt;⑦ 命令通过SSH连接池发送到目标服务器&lt;br&gt;⑧ 执行结果反馈给LLM，决定继续或完成&lt;br&gt;⑨ 每步事件通过EventStore + SSE实时推送到前端&lt;br&gt;⑩ 所有操作记录到SQLite（日志/审计/快照）" style="text;html=1;fontSize=11;align=left;fillColor=#f8f9fa;strokeColor=#dee2e6;rounded=1;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="870" y="500" width="310" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
